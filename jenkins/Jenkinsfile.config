// Job: 02-config-ansible  (triggered automatically after a successful 01-infra-terraform apply)
pipeline {
  agent any
  options { timestamps(); disableConcurrentBuilds(); timeout(time: 40, unit: 'MINUTES') }
  environment {
    AWS_REGION          = 'ap-southeast-2'
    CLUSTER             = 'shopnow-dev'
    ANSIBLE_FORCE_COLOR = 'true'
  }
  stages {
    stage('Kubeconfig') {
      steps { sh 'aws eks update-kubeconfig --name $CLUSTER --region $AWS_REGION && kubectl get nodes -o wide' }
    }
    stage('Syntax check') {
      steps { dir('ansible') { sh 'ansible-inventory --graph && ansible-playbook site.yml --syntax-check' } }
    }
    stage('Configure') {
      steps {
        withCredentials([
          sshUserPrivateKey(credentialsId: 'ec2-ssh-key', keyFileVariable: 'SSH_KEY', usernameVariable: 'SSH_USER'),
          string(credentialsId: 'mongodb-uri',   variable: 'MONGODB_URI'),
          string(credentialsId: 'grafana-admin', variable: 'GRAFANA_ADMIN_PASSWORD'),
          string(credentialsId: 'slack-webhook', variable: 'SLACK_WEBHOOK')]) {
          dir('ansible') {
            sh 'ansible-playbook site.yml --private-key "$SSH_KEY" -u "$SSH_USER"'
            sh 'ansible role_tools -m command -a "docker --version" --private-key "$SSH_KEY" -u "$SSH_USER"'
          }
        }
      }
    }
    stage('Infra check') {
      steps { sh 'bash tests/infra_check.sh' }
    }
  }
  post {
    success { build job: '03-shopnow-cicd', parameters: [booleanParam(name: 'DEPLOY_ONLY', value: true)], wait: false }
    failure { slackSend color: 'danger', message: "02-config-ansible FAILED: ${env.BUILD_URL}" }
  }
}
